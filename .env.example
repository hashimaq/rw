# Supabase (browser + server anon client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Optional: site URL for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production is install-first (browser blocked until PWA). Dev allows browser use.
# Set to 1 only for temporary browser testing of a production build locally.
# NEXT_PUBLIC_ALLOW_BROWSER_APP=1

# Admin passwords: scripts/admin-provision.local.json (gitignored) — NOT in .env
