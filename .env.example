# Supabase (browser + server anon client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Optional: site URL for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PWA-only app (production default ON): normal browser tabs see full-screen install gate only.
# NEXT_PUBLIC_PWA_INSTALL_GATE_ENABLED=0   # opt out in production
# NEXT_PUBLIC_PWA_INSTALL_GATE_ENABLED=1   # force on in development

# Local prod-build testing without installing the PWA (disables install gate + browser scoring policy).
# NEXT_PUBLIC_ALLOW_BROWSER_APP=1

# Scoring requires installed PWA in production (default). Set 0 to allow browser scoring in prod.
# NEXT_PUBLIC_SCORING_REQUIRES_PWA=0

# Admin passwords: scripts/admin-provision.local.json (gitignored) — NOT in .env

# Server-only — completed-match AI analysis (never expose to the client)
GEMINI_API_KEY=
# Optional: gemini (default) | openai
# MATCH_AI_PROVIDER=gemini
# GEMINI_MATCH_ANALYSIS_MODEL=gemini-3.5-flash-lite
# GEMINI_DELIVERY_COMMENTARY_MODEL=gemini-3.5-flash-lite
# GEMINI_DELIVERY_COMMENTARY_TTS_MODEL=gemini-2.5-flash-preview-tts
# Optional faster TTS (streaming on 3.1+); falls back to GEMINI_DELIVERY_COMMENTARY_TTS_MODEL_FALLBACK
# GEMINI_DELIVERY_COMMENTARY_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_DELIVERY_COMMENTARY_TTS_MODEL_FALLBACK=gemini-2.5-flash-preview-tts
# GEMINI_DELIVERY_COMMENTARY_VOICE=Puck
# Server: DELIVERY_COMMENTARY_LATENCY_LOG=1
# Client: NEXT_PUBLIC_DELIVERY_COMMENTARY_LATENCY_LOG=1

# Legacy OpenAI provider (only if MATCH_AI_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MATCH_ANALYSIS_MODEL=gpt-4o-mini
