NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Optional: site URL for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

